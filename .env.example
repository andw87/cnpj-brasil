# Copy to .env and adjust. .env is never versioned.
CNPJBENCH_MONGO_URI=mongodb://127.0.0.1:27017
CNPJBENCH_MONGO_DB=cnpjbench
CNPJBENCH_SEED_FILE=data/seed/seed_companies.jsonl
CNPJBENCH_USER_AGENT=cnpjbench/0.1 (research benchmark)
CNPJBENCH_HTTP_TIMEOUT_S=20
CNPJBENCH_MAX_RETRIES=2

# Tokens for sources with status pending_credentials (see catalog/sources.yaml)
CNPJBENCH_S10_TOKEN=
